# ==============================================================================
# NEXUS AI TRADER — Environment Configuration Template
# Copy to `.env` for local or Docker Compose runs. NEVER commit `.env`.
# ==============================================================================

# --- Application ---
APP_NAME=nexus-ai-trader
APP_ENV=development
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
API_AUTH_TOKEN=change_me_to_strong_secret_token
RATE_LIMIT_PER_MINUTE=120
# Set to true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Optional narrow regex for allowed browser origins. Leave empty to disable.
CORS_ORIGIN_REGEX=^https://nexus-ai-trader[a-z0-9-]*\.onrender\.com$

# --- Non-Negotiable Trading Invariants ---
# Changing these to live/margin/futures/withdrawals will fail startup validation.
TRADING_MODE=paper
MARKET_TYPE=spot
LIVE_TRADING_ENABLED=false
ALLOW_LEVERAGE=false
ALLOW_FUTURES=false
ALLOW_WITHDRAWALS=false
# Enables the isolated-margin futures SIMULATOR only. Live futures stay blocked.
PAPER_FUTURES_ENABLED=true

# --- Virtual Portfolio & Universe ---
INITIAL_CAPITAL_INR=10000.00
BASE_CURRENCY=INR
ALLOWED_SYMBOLS=["BTC/USDT","ETH/USDT","SOL/USDT","BNB/USDT","ADA/USDT","AVAX/USDT","SUI/USDT","NEAR/USDT","APT/USDT","DOT/USDT","SEI/USDT","ATOM/USDT","ALGO/USDT","FTM/USDT","ETC/USDT","LINK/USDT","UNI/USDT","AAVE/USDT","MKR/USDT","CRV/USDT","LDO/USDT","PENDLE/USDT","JUP/USDT","ONDO/USDT","INJ/USDT","RUNE/USDT","FET/USDT","RENDER/USDT","TAO/USDT","ICP/USDT","THETA/USDT","FIL/USDT","TIA/USDT","DOGE/USDT","SHIB/USDT","PEPE/USDT","WIF/USDT","BONK/USDT","FLOKI/USDT","XRP/USDT","LTC/USDT","BCH/USDT","TRX/USDT","ARB/USDT","OP/USDT","STX/USDT","GALA/USDT","SAND/USDT","MANA/USDT","AXS/USDT","ETH/BTC","SOL/BTC","BNB/BTC","SOL/ETH"]
SUPPORTED_TIMEFRAMES=["5m","15m","1h","4h"]
DEFAULT_TIMEFRAME=15m
PAPER_FEE_BPS=10.0
PAPER_SLIPPAGE_BPS=5.0

# --- Risk Management Limits ---
RISK__RISK_PER_TRADE_PCT=0.5
RISK__MAX_POSITION_NOTIONAL_PCT=20.0
RISK__MAX_CONCURRENT_POSITIONS=2
RISK__DAILY_LOSS_LIMIT_PCT=2.0
RISK__MAX_DRAWDOWN_PCT=8.0
RISK__MAX_DAILY_ENTRIES=5
RISK__MIN_ORDER_NOTIONAL_INR=50.00

# --- Strategy Engine V1 (EMA Trend + RSI + ATR + Volume) ---
STRATEGY_V1__EMA_FAST_PERIOD=20
STRATEGY_V1__EMA_SLOW_PERIOD=50
STRATEGY_V1__RSI_PERIOD=14
STRATEGY_V1__RSI_ENTRY_MIN=50.0
STRATEGY_V1__RSI_ENTRY_MAX=70.0
STRATEGY_V1__ATR_PERIOD=14
STRATEGY_V1__VOLUME_SMA_PERIOD=20
STRATEGY_V1__STOP_ATR_MULTIPLIER=2.0
STRATEGY_V1__TRAILING_ATR_MULTIPLIER=2.5

# --- Advisory AI Market Analysis (Multi-Provider Resilient Fallback Chain) ---
AI__ENABLED=true
AI__PROVIDER=openai_compatible
AI__BASE_URL=https://integrate.api.nvidia.com/v1
AI__API_KEY=your_nvidia_or_openai_api_key_here
AI__MODEL=mistralai/mistral-large-4-1t-a52b
AI__TIMEOUT_S=45.0
AI__MAX_RETRIES=1
AI__CACHE_TTL_SECONDS=300
AI__FALLBACK_TO_DETERMINISTIC=true

# Fallback AI Providers
AI__FALLBACK_1_NAME=crow_llm
AI__FALLBACK_1_BASE_URL=https://crowllm.com/v1
AI__FALLBACK_1_API_KEY=your_crowllm_api_key_here
AI__FALLBACK_1_MODEL=crow-uncensored:free
AI__FALLBACK_1_TIMEOUT_S=15.0

AI__FALLBACK_2_NAME=hcnote
AI__FALLBACK_2_BASE_URL=https://hcnote.cn/2026/07/12/12831.html/v1
AI__FALLBACK_2_API_KEY=your_hcnote_api_key_here
AI__FALLBACK_2_MODEL=auto
AI__FALLBACK_2_TIMEOUT_S=10.0

# --- Exchange (Public Spot Market Data Only — No Private API Keys) ---
EXCHANGE_ID=binance
EXCHANGE_TIMEOUT_MS=10000
MARKET_DATA_MAX_RETRIES=3
MARKET_DATA_BACKOFF_BASE_S=0.5
WS_ENABLED=true
WS_RECONNECT_MIN_DELAY_S=1.0
WS_RECONNECT_MAX_DELAY_S=30.0

# --- PostgreSQL Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexus_trader
POSTGRES_USER=nexus
# Replace with a strong secret in `.env` before running Docker Compose or prod
POSTGRES_PASSWORD=change_me_in_local_env
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
# Must match API_AUTH_TOKEN. No fallback token is compiled into the frontend.
VITE_API_AUTH_TOKEN=change_me_to_strong_secret_token

